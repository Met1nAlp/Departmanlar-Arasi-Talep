{
  "expo": {
    "name": "Mepsan MTS",
    "slug": "talep-uygulamasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mepsan-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mepsan.talepuygulamasi",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ürün QR kodunu okutmak için kameraya erişim gerekiyor."
        }
      ],
      "expo-secure-store",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Kartınızı okutarak giriş yapmak için NFC erişimi gerekiyor.",
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/mepsan-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0057B8"
        }
      ],
      "@lovesworking/watermelondb-expo-plugin-sdk-52-plus",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0057B8"
        }
      ]
    ],
    "extra": {
      "realtimeWsUrl": "",
      "mepsanServerUrl": "ws://192.168.151.24:1234",
      "eas": {
        "projectId": "a406fa4a-b98a-4acd-958a-d6e2ecddd8f0"
      }
    }
  }
}